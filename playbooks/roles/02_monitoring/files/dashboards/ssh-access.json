                "sort": "desc"
              }
            }
          },
          "version": "13.0.1+security-01"
        }
      }
    },
    "panel-2": {
      "kind": "Panel",
      "spec": {
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "P8E80F9AEF21F6940"
                    },
                    "group": "loki",
                    "kind": "DataQuery",
                    "spec": {
                      "direction": "backward",
                      "editorMode": "code",
                      "expr": "{job=\"varlogs\"} |~ \"sshd.*(Accepted (publickey|password)|Failed password|Invalid user|Connection closed by|Connection reset by)\"",
