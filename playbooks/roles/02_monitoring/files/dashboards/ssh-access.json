  "cursorSync": "Off",
  "description": "SSH authentication activity from host logs (Loki).",
  "editable": true,
  "elements": {
    "panel-1": {
      "kind": "Panel",
      "spec": {
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "P8E80F9AEF21F6940"
                    },
                    "group": "loki",
                    "kind": "DataQuery",
                    "spec": {
                      "editorMode": "code",
                      "expr": "sum(count_over_time({job=\"varlogs\"} |~ \"sshd.*Accepted (publickey|password)\" [$__interval]))",
                      "legendFormat": "successful"
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              },
              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "P8E80F9AEF21F6940"
                    },
                    "group": "loki",
                    "kind": "DataQuery",
                    "spec": {
                      "editorMode": "code",
                      "expr": "sum(count_over_time({job=\"varlogs\"} |~ \"sshd.*(Failed password|Invalid user)\" [$__interval]))",
                      "legendFormat": "failed"
                    },
                    "version": "v0"
                  },
                  "refId": "B"
                }
              }
            ],
            "queryOptions": {
              "interval": "5m"
            },
            "transformations": []
          }
        },
        "description": "Successful vs failed SSH authentications over time.",
        "id": 1,
        "links": [],
