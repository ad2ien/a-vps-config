x-superset: &superset
  image: apache/superset:6.1.0
  env_file: .env
  restart: unless-stopped
  volumes:
    - superset_home:/app/superset_home

name: {{ tenant }}-superset
services:
  redis:
    image: redis:7.2-alpine
    restart: unless-stopped
    volumes:
      - redis:/data
    networks:
      - internal

  db:
    image: postgres:18.4-alpine3.24
    env_file: .env
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER} -d ${POSTGRES_DB}"]
      interval: 10s
      timeout: 5s
      retries: 5
    volumes:
      - db_home:/var/lib/postgresql/data
    networks:
      - internal

  superset-init:
    <<: *superset
    restart: "no"
    command:
      - /bin/sh
      - -c
      - |
        superset db upgrade
        superset fab create-admin \
          --username "$$SUPERSET_ADMIN_USERNAME" \
          --firstname "$$SUPERSET_ADMIN_FIRSTNAME" \
          --lastname "$$SUPERSET_ADMIN_LASTNAME" \
          --email "$$SUPERSET_ADMIN_EMAIL" \
          --password "$$SUPERSET_ADMIN_PASSWORD" || true
        superset init
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_started
    networks:
      - internal

  superset:
    <<: *superset
    command:
      - gunicorn
      - -w
      - "4"
      - -k
      - gevent
      - --timeout
      - "120"
      - -b
      - 0.0.0.0:8088
      - superset.app:create_app()
    depends_on:
      superset-init:
        condition: service_completed_successfully
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=${TRAEFIK_NETWORK}"
      - "traefik.http.routers.superset-{{ tenant }}.rule=Host(`${SUB_DOMAIN}.${DOMAIN}`)"
      - "traefik.http.routers.superset-{{ tenant }}.entrypoints=websecure"
      - "traefik.http.services.superset-{{ tenant }}.loadbalancer.server.port=8088"
      - "traefik.http.routers.superset-{{ tenant }}.tls.certresolver=letsencrypt"
      - "traefik.http.routers.superset-{{ tenant }}.middlewares=crowdsec@docker"
    networks:
      - traefik
      - internal

  superset-worker:
    <<: *superset
    command:
      - celery
      - --app=superset.tasks.celery_app:app
      - worker
      - --pool=prefork
      - -O
      - fair
      - -c
      - "4"
    depends_on:
      superset-init:
        condition: service_completed_successfully
    networks:
      - internal

  superset-worker-beat:
    <<: *superset
    command:
      - celery
      - --app=superset.tasks.celery_app:app
      - beat
    depends_on:
      superset-init:
        condition: service_completed_successfully
    networks:
      - internal

volumes:
  superset_home:
  db_home:
  redis:

networks:
  internal:
  traefik:
    external: true
    name: ${TRAEFIK_NETWORK}
